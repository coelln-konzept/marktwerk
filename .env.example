# Copy to .env and adjust. Never commit .env.

# --- Database (docker compose default) ---
DATABASE_URL=postgres://marktwerk:marktwerk@localhost:5432/marktwerk
# Optional: separate session-mode URL for migrations (Supabase: pooler port 5432; app uses port 6543)
# DATABASE_MIGRATION_URL=
# Integration tests (default: same server, database marktwerk_test on :5432; the name must end in _test)
# TEST_DATABASE_URL=postgres://marktwerk:marktwerk@localhost:5432/marktwerk_test

# --- App ---
APP_URL=http://localhost:3000
# Company time zone used for market days and relative deadlines
APP_TIMEZONE=Europe/Berlin

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# --- Scheduler for serverless hosting: bearer token for /api/cron/<job> (openssl rand -hex 32) ---
# CRON_SECRET=

# --- Outgoing email (Mailpit in dev, UI at http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="marktwerk <noreply@marktwerk.local>"

# --- File storage ---
# "local" stores files under ./.data/files; "s3" uses the S3_* variables (EU bucket in production)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Seed: first owner account created by `pnpm db:seed` ---
SEED_OWNER_EMAIL=owner@marktwerk.local
SEED_OWNER_PASSWORD=marktwerk-dev-123
SEED_OWNER_NAME=Owner

# --- Phase 2: Microsoft 365 mailbox integration (Graph API, app registration in Entra ID) ---
# M365_TENANT_ID=
# M365_CLIENT_ID=
# M365_CLIENT_SECRET=
